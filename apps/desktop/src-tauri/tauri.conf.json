{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiverGuard",
  "version": "0.2.0",
  "identifier": "com.sky.liverguard",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiverGuard",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: asset:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist"
    }
  }
}
