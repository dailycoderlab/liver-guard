{
  "name": "sky-platform",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "sky", "database_id": "local-sky-replace-on-deploy" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "sky-assets" }
  ],
  "observability": { "enabled": true }
}
