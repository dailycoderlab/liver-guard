{
  "name": "sky-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:console": "vite build --config console/vite.config.ts --watch",
    "build": "vite build --config console/vite.config.ts",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply sky --local",
    "db:remote": "wrangler d1 migrations apply sky --remote"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
